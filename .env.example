# Copy values into your process environment; SparkRouter does not read .env itself.
# Helpers can load this format explicitly: --env-file .env (Bash) / -EnvFile .env (PowerShell).
# Values are literal; no shell expansion, inline comments, or empty values.
ROUTER_DATABASE_URL=sqlite://router.db
# REQUIRED: base64 encoding of 32 cryptographically random bytes.
# Generate with: openssl rand -base64 32
ROUTER_MASTER_KEY=REPLACE_WITH_BASE64_KEY
# Optional: unset to allow API calls without authentication, unless a dashboard
# API key exists. Do not set to empty.
# ROUTER_API_KEY=choose-a-long-random-local-gateway-key
# The dashboard always requires a password. By default you choose it at /setup
# with the one-time code the server logs on first start. Optionally fix it here
# instead (16–1024 bytes; use a long random password).
# ROUTER_DASHBOARD_PASSWORD=choose-a-long-random-admin-password
# Only behind an authenticating reverse proxy: turn the dashboard login off.
# ROUTER_DASHBOARD_AUTH=disabled
# Only while running rotate-key: the new master key (save it first).
# ROUTER_NEW_MASTER_KEY=REPLACE_WITH_NEW_BASE64_KEY
# Set true when serving the dashboard through HTTPS; false for localhost HTTP.
# ROUTER_DASHBOARD_SECURE_COOKIE=true
# Optional bearer token for GET /metrics (16–256 bytes), accepted alongside a
# token generated in Settings. Without either, /metrics is off.
# ROUTER_METRICS_TOKEN=choose-a-long-random-scrape-token
ROUTER_BIND=127.0.0.1:14673
RUST_LOG=info
